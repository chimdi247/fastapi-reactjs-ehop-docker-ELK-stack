# =====================================================================================
# ShopEase — compose environment.   cp .env.example .env   then:  docker compose up -d --build
# Everything below has a working local default. Replace the third-party values (Stripe, Google, SMTP,
# real AWS) to enable those integrations. NEVER commit .env.
# =====================================================================================

# ── API secrets ───────────────────────────────────────────────────────────────────────
SECRETE_JWT_KEY=fcd236e96f70bd32788fd15282e9038941f4efadeed80d451920576d3a0c04c9

# ── Public URLs (what the BROWSER uses) ───────────────────────────────────────────────
FRONTEND_URL=http://136.71.169.139:3000
BACKEND_URL=http://136.71.169.139:8084
RESET_PASSWORD_URL=http://136.71.169.139:3000/reset-password
PAYMENT_CONFIRMATION_URL=http://136.71.169.139:3000/payment/success
PAYMENT_CANCEL_URL=http://136.71.169.139:3000/payment/cancel
# Frontend build arg: where the browser calls the API. Empty => same-origin "/api" via the nginx proxy.
VITE_BACKEND_URL=http://136.71.169.139:8084

# ── Third-party integrations (placeholders: the app boots, these features just won't work) ──
STRIPE_SECRET_KEY=sk_test_placeholder
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_AUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth
# must exactly match an "Authorised redirect URI" in your Google Cloud console
GOOGLE_REDIRECT_URL=http://136.71.169.139:8084/api/auth/google/callback

# ── Application e-mail (defaults to the bundled Mailpit sink: http://localhost:8025) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=chimdi247@gmail.com
MAIL_PASS=dzvjhzclrgkxtuiy
MAIL_FROM=no-reply@shopease.com
MAIL_START_TLS=true          # true for real SMTP servers (Gmail: smtp.gmail.com / 587 / true)
MAIL_VALIDATE_CERTS=true
DELIVERY_PERSON_EMAIL=shimdi247@gmail.com

# ── S3 object storage ─────────────────────────────────────────────────────────────────
# Default: the bundled MinIO (S3-compatible). Used by: product images, Mimir (metrics), Logstash
# (log archive) and Elasticsearch (snapshots).
#
# To use REAL AWS S3 instead, set:
#   S3_ENDPOINT=s3.<region>.amazonaws.com   S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com
#   S3_PROTOCOL=https  S3_INSECURE=false  S3_PATH_STYLE=false  S3_REGION=<region>
#   S3_ACCESS_KEY=<key> S3_SECRET_KEY=<secret>   and your own bucket names below
#   AWS_ENDPOINT_URL=            (empty = real S3, for the API)
#   AWS_PUBLIC_BASE_URL=         (empty = https://<bucket>.s3.<region>.amazonaws.com)

S3_ENDPOINT=minio:9000
S3_ENDPOINT_URL=http://minio:9000
S3_PROTOCOL=http
S3_INSECURE=true
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_ACCESS_KEY=shopease-minio
S3_SECRET_KEY=shopease-minio-secret
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler
LOGS_ARCHIVE_BUCKET=elk-logs-archive
ES_SNAPSHOT_BUCKET=es-snapshots
UPLOADS_BUCKET=ecommerce-uploads
AWS_ENDPOINT_URL=http://minio:9000
AWS_PUBLIC_BASE_URL=http://136.71.169.139:9000/ecommerce-uploads

# ── Retention ─────────────────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=30            # Elasticsearch ILM delete + snapshot expiry
LOGS_ARCHIVE_RETENTION_DAYS=90   # S3 lifecycle on the log archive bucket

# ── Database (dev creds also live in docker/postgres/init/00-roles.sql — change both) ──
POSTGRES_PASSWORD=postgres_admin_pw
DB_APP_PASSWORD=shopease_app_pw
DB_EXPORTER_PASSWORD=exporter_pw

# ── Grafana ───────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Alert e-mails (Grafana-managed alerts). Default: bundled Mailpit. ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=dzvjhzclrgkxtuiy
SMTP_FROM_ADDRESS=grafana-alerts@shopease.com
SMTP_FROM_NAME=ShopEase Alerts
SMTP_STARTTLS_POLICY=MandatoryStartTLS
SMTP_SKIP_VERIFY=true
ALERT_EMAIL_TO=shimdi247@gmail.com
ALERT_CPU_THRESHOLD=40
ALERT_MEM_THRESHOLD=40

# ── Image versions (bump deliberately) ────────────────────────────────────────────────
ELASTIC_VERSION=8.19.16
MIMIR_VERSION=2.15.0
