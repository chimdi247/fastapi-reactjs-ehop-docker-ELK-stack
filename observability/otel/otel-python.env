# OpenTelemetry settings for the Python API — the SAME variables docker-compose.yml injects.
# Use this file to run the API on your laptop (outside Docker) against the compose stack:
#
#   set -a; source observability/otel/otel-python.env; set +a
#   cd fastapi-eccomerce-backend && opentelemetry-instrument uvicorn app.main:app --port 8084
#
# (the collector publishes OTLP on 127.0.0.1:4318)
OTEL_SERVICE_NAME=shopease-api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=shopease,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# all three signals over OTLP
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# W3C trace-context + baggage propagation (incoming + outgoing HTTP)
OTEL_PROPAGATORS=tracecontext,baggage

# ship Python `logging` records as OTLP logs and stamp trace/span ids on them
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_PYTHON_LOG_CORRELATION=true

# stable HTTP semantic conventions: http.server.request.duration in SECONDS
# (-> http_server_request_duration_seconds_* in Mimir; the dashboards rely on this)
OTEL_SEMCONV_STABILITY_OPT_IN=http

# do not trace / measure probes (keeps SLIs honest)
OTEL_PYTHON_EXCLUDED_URLS=api/health,ready,hello

# auto-instrumentation extras
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=api/health,ready,hello
